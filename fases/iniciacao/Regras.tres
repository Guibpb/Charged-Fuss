[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://fases/RegrasFase.gd" id="1_regras"]
[ext_resource type="Script" path="res://fases/Rodada.gd" id="2_rodada"]

[sub_resource type="Resource" id="Rodada_1"]
script = ExtResource("2_rodada")
quantidade = 5
vida = 40
velocidade = 4.0
intervalo = 1.8
tutorial = "Arraste sua primeira torre até uma base para começar."

[sub_resource type="Resource" id="Rodada_2"]
