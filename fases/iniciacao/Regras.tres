script = ExtResource("2_rodada")
quantidade = 15
vida = 48
velocidade = 4.5
intervalo = 1.1
tutorial = "Você pode abrir o painel durante a partida; o jogo continuará acontecendo."

[sub_resource type="Resource" id="Rodada_7"]
script = ExtResource("2_rodada")
quantidade = 17
vida = 50
velocidade = 4.6
intervalo = 1.0
tutorial = "Distribua as torres para cobrir trechos diferentes do caminho."

[sub_resource type="Resource" id="Rodada_8"]
