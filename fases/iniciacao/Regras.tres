quantidade = 7
vida = 40
velocidade = 4.0
intervalo = 1.6
tutorial = "Compare a torre normal com a rápida: elas têm ritmos e alcances diferentes."

[sub_resource type="Resource" id="Rodada_3"]
script = ExtResource("2_rodada")
quantidade = 9
vida = 42
velocidade = 4.2
intervalo = 1.5
tutorial = "Cada inimigo derrotado gera energia para posicionar mais torres."

