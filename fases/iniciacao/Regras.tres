quantidade = 26
vida = 60
velocidade = 5.0
intervalo = 0.72
tutorial = "Última rodada: derrote o chefe, que tem três vezes a vida normal."
tem_chefe = true

[resource]
script = ExtResource("1_regras")
titulo_menu = "Fase 1 - Iniciação"
mensagem_vitoria = "Parabéns! Você completou o Nível 1 - Iniciação!"
vida_inicial = 50
energia_inicial = 100
energia_por_eliminacao = 1
bonus_rodada = 15
dano_fuga = 1
dano_fuga_chefe = 35
multiplicador_vida_chefe = 5
intervalo_entre_rodadas = 3.0
custos_torres = Dictionary[String, int]({"basica": 60, "rapida": 70, "tesla": 65, "chama": 70})
custos_upgrades = Dictionary[String, int]({"dano": 45, "alcance": 30, "velocidade": 55, "balas": 65, "tesla_rapidez": 55, "tesla_alcance": 35, "chama_dano": 45, "chama_alcance": 35})
atributos_torres = Dictionary[String, Dictionary]({
"rapida": {"shot_range": 4.8, "shot_interval": 0.22},
"tesla": {"shot_range": 5.8, "damage": 4},
"chama": {"shot_range": 4.4, "damage": 5}
})
rodadas = Array[ExtResource("2_rodada")]([SubResource("Rodada_1"), SubResource("Rodada_2"), SubResource("Rodada_3"), SubResource("Rodada_4"), SubResource("Rodada_5"), SubResource("Rodada_6"), SubResource("Rodada_7"), SubResource("Rodada_8"), SubResource("Rodada_9"), SubResource("Rodada_10")])
