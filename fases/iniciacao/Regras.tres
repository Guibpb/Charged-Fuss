quantidade = 19
vida = 54
velocidade = 4.8
intervalo = 0.9
tutorial = "Mais inimigos estarão na rota ao mesmo tempo. Acompanhe o campo inteiro."

[sub_resource type="Resource" id="Rodada_9"]
script = ExtResource("2_rodada")
quantidade = 22
vida = 56
velocidade = 4.9
intervalo = 0.85
tutorial = "Prepare suas torres para a rodada final e guarde energia quando puder."

[sub_resource type="Resource" id="Rodada_10"]
