[resource]
script = ExtResource("1_regras")
titulo_menu = "Fase 1 - Iniciação"
instrucao_inicial = "Arraste uma defesa até uma base livre perto da pista."
mensagem_vitoria = "Parabéns! Você completou o Nível 1 - Iniciação!"
vida_inicial = 50
energia_inicial = 105
energia_por_eliminacao = 1
bonus_rodada = 20
dano_fuga = 1
dano_fuga_chefe = 35
multiplicador_vida_chefe = 3
intervalo_entre_rodadas = 3.0
custos_torres = Dictionary[String, int]({"basica": 60, "rapida": 65, "tesla": 55, "chama": 65})
custos_upgrades = Dictionary[String, int]({"dano": 45, "alcance": 42, "velocidade": 45, "balas": 55, "tesla_rapidez": 45, "tesla_alcance": 32, "chama_dano": 40, "chama_alcance": 32})
atributos_torres = Dictionary[String, Dictionary]({
"basica": {"shot_range": 6.1},
"rapida": {"shot_range": 5.6, "shot_interval": 0.24, "damage": 8},
"tesla": {"shot_range": 6.3, "damage": 5},
"chama": {"shot_range": 5.5, "damage": 7}
})
rodadas = Array[ExtResource("2_rodada")]([SubResource("Rodada_1"), SubResource("Rodada_2"), SubResource("Rodada_3"), SubResource("Rodada_4"), SubResource("Rodada_5"), SubResource("Rodada_6"), SubResource("Rodada_7"), SubResource("Rodada_8"), SubResource("Rodada_9"), SubResource("Rodada_10")])
